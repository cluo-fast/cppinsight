{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CppInsight AI",
  "version": "0.1.0",
  "identifier": "ai.cppinsight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CppInsight AI",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/cppinsight.exe"
    ]
  }
}
